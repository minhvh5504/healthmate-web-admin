# Map Services
# Mapbox
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# Goong Map
NEXT_PUBLIC_GOONG_API_KEY=your_goong_api_key_here
NEXT_PUBLIC_GOONG_MAPTILES_KEY=your_goong_maptiles_key_here
